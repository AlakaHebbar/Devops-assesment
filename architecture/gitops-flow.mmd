flowchart LR
    dev(["Developer"])
    ops(["Operator<br/>once per cluster"])

    subgraph github["GitHub"]
        repo[("Git repo · main<br/>source of truth")]
        appci["app-ci<br/>lint · build · Trivy"]
    end

    subgraph aws["AWS"]
        ecr[("ECR<br/>immutable :commit-sha")]
    end

    subgraph cluster["EKS cluster · only Argo CD writes here"]
        argocd["Argo CD<br/>auto-sync · prune · self-heal"]
        subgraph platform["k8s/platform ApplicationSets"]
            addons["Add-ons<br/>LB controller · external-dns<br/>metrics-server · Fluent Bit<br/>Argo CD itself"]
        end
        subgraph svc["k8s/ · namespace next-bff"]
            pods["next-bff-service pods<br/>readiness/liveness: /api/health"]
            smoke["PostSync smoke test<br/>GET /api/health"]
        end
    end

    %% Deploy path, numbered in order
    dev -->|"1 · git push"| repo
    repo -->|"2 · on push"| appci
    appci -->|"3 · push image :sha (OIDC)"| ecr
    appci -->|"4 · commit newTag = sha"| repo
    argocd -->|"5 · poll main every 3 min"| repo
    argocd -->|"6 · sync k8s/"| pods
    ecr -->|"7 · pull image"| pods
    argocd -->|"8 · health gate"| smoke
    smoke -.-> pods

    %% Everything else in the cluster is Git too
    argocd -->|"sync k8s/platform"| addons
    ops -->|"bootstrap: install Argo CD + root app"| argocd

    %% Self-heal and rollback
    kubectl(["Manual kubectl edit"]) -.->|"drift"| pods
    argocd -.->|"self-heal reverts it"| pods
    revert(["git revert bad app commit"]) -.->|"rollback = new commit, rebuilt and redeployed"| repo

    classDef git fill:#EEEDFE,stroke:#534AB7,color:#26215C
    classDef awsc fill:#E1F5EE,stroke:#0F6E56,color:#04342C
    classDef argo fill:#FAECE7,stroke:#993C1D,color:#4A1B0C
    classDef warn fill:#FAEEDA,stroke:#854F0B,color:#412402
    class repo,appci git
    class ecr awsc
    class argocd,addons argo
    class kubectl,revert warn
