flowchart LR
    users(["Users / browsers"])
    dev(["Engineers<br/>pull requests"])
    ops(["Operator · once per cluster<br/>infra/gitops-bootstrap"])

    subgraph github["GitHub"]
        repo["Git repository · main<br/>application/ · k8s/ · infra/"]
        appci["app-ci workflow · every push<br/>lint · build · scan · push<br/>commit image tag to k8s/"]
        infraci["infra workflow · AWS APIs only<br/>PR: fmt · validate · tflint · plan<br/>main: apply after approval"]
        env["production environment<br/>required reviewers"]
        store["Actions secrets / variables<br/>tfvars · role ARNs"]
    end

    dev --> repo
    repo --> appci
    repo --> infraci
    appci -->|"bot commit: newTag = commit SHA"| repo
    infraci --- env
    store -.-> infraci

    subgraph aws["AWS production account / region"]
        r53["Route 53<br/>public hosted zone"]
        waf["WAFv2 web ACL<br/>rate limit · managed rules"]
        acm["ACM certificate"]

        subgraph identity["IAM · GitHub OIDC (short-lived, no stored keys)"]
            pub["ci-image-publisher<br/>push to one ECR repo"]
            plan["ci-terraform-plan<br/>read-only · pull_request"]
            apply["ci-terraform-apply<br/>environment: production"]
        end

        ecr["ECR<br/>immutable tags · scan on push · KMS"]
        state["S3 Terraform state<br/>versioned · KMS · lock file"]
        secrets["Secrets Manager<br/>app secrets · Argo CD deploy key"]
        s3["S3 log archive<br/>Block Public Access · SSE-KMS<br/>versioning · lifecycle"]
        cw["CloudWatch<br/>control-plane logs · Container Insights · alarms"]
        sns["SNS alerts"]

        subgraph vpc["VPC 10.20.0.0/16 · 3 Availability Zones"]
            subgraph public["Public subnets"]
                alb["Application Load Balancer<br/>HTTPS · TLS 1.3/1.2"]
                nat["NAT gateway per AZ"]
            end

            subgraph private["Private subnets"]
                endpoints["VPC endpoints<br/>ECR · S3 · STS · EKS Auth · Logs · Secrets Manager"]

                subgraph eks["EKS · private API endpoint · no CI access entries"]
                    api["Kubernetes API"]
                    argocd["Argo CD · manages itself<br/>auto-sync · prune · self-heal"]
                    subgraph platform["Platform add-ons (k8s/platform ApplicationSets)"]
                        lbc["AWS Load Balancer Controller"]
                        extdns["external-dns"]
                        ms["metrics-server"]
                        fb["Fluent Bit DaemonSet<br/>disk buffer · retry"]
                    end
                    subgraph ns["namespace next-bff · restricted PSS"]
                        ing["Ingress"]
                        svc["Service"]
                        app["next-bff-service Deployment<br/>probes on /api/health<br/>HPA 3–12 · PDB · NetworkPolicy"]
                        smoke["PostSync smoke test<br/>GET /api/health"]
                    end
                end
            end
        end
    end

    %% Request path
    users --> r53 --> alb
    waf --- alb
    acm --- alb
    alb --> svc --> app

    %% Delivery: CI changes Git, Argo CD changes the cluster
    appci -->|"OIDC"| pub -->|"docker push :sha"| ecr
    argocd -->|"SSH deploy key · poll main"| repo
    argocd -->|"k8s/platform"| platform
    argocd -->|"apply k8s/"| ing
    argocd --> app
    argocd --> smoke
    smoke -.-> svc
    ecr -->|"node role pulls via endpoint"| app

    %% Infrastructure pipeline
    infraci -->|"PR plan"| plan
    infraci -->|"apply after approval"| apply
    plan -.-> state
    apply --> state
    ops -->|"install Argo CD · root app"| api

    %% Controllers
    lbc -->|"provisions"| alb
    lbc -.-> ing
    extdns -->|"alias record"| r53
    ms -.->|"CPU metrics"| app

    %% Logs and monitoring
    app -.->|"stdout JSON"| fb
    fb -->|"Pod Identity · PutObject eks/*"| s3
    app -.->|"Pod Identity · read prod/next-bff-service/*"| secrets
    api --> cw --> sns
    private -.->|"egress"| nat
    eks -.-> endpoints
