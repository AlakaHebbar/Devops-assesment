        <mxCell id="argo" value="&lt;b&gt;Argo CD&lt;/b&gt;&lt;br&gt;makes the cluster match Git" style="fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=15;strokeColor=#F8C99B;fillColor=#FFFFFF;fontColor=#1F2937;verticalAlign=middle;align=center;strokeWidth=2;" vertex="1" parent="1">
