        <mxCell id="github" value="GitHub" style="fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;rounded=1;arcSize=3;whiteSpace=wrap;html=1;fontSize=15;fontStyle=1;strokeColor=#CBD5E1;dashed=0;fillColor=#F8FAFC;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontColor=#1F2937;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1620" y="90" width="380" height="130" />
        </mxCell>
        <mxCell id="git" value="&lt;b&gt;Git repository · k8s/ folder&lt;/b&gt;&lt;br&gt;image tag written by CI" style="fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=15;strokeColor=#CBD5E1;fillColor=#FFFFFF;fontColor=#1F2937;verticalAlign=middle;align=center;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1640" y="130" width="340" height="64" />
        </mxCell>
        <mxCell id="panel" value="How to read this" style="fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;rounded=1;arcSize=3;whiteSpace=wrap;html=1;fontSize=15;fontStyle=1;strokeColor=#CBD5E1;dashed=0;fillColor=#F8FAFC;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontColor=#1F2937;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1620" y="250" width="380" height="945" />
        </mxCell>
        <mxCell id="steps" value="&lt;b style='font-size:16px;color:#1F2937'&gt;A user request&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b style='color:#3B82F6'&gt;1&lt;/b&gt;&amp;nbsp;&amp;nbsp;The browser looks up the site in Route 53.&lt;br&gt;&lt;br&gt;&lt;b style='color:#3B82F6'&gt;2&lt;/b&gt;&amp;nbsp;&amp;nbsp;It sends HTTPS to the load balancer. WAF filters it and the ACM certificate decrypts it.&lt;br&gt;&lt;br&gt;&lt;b style='color:#3B82F6'&gt;3&lt;/b&gt;&amp;nbsp;&amp;nbsp;The load balancer sends it straight to a healthy pod on port 3000.&lt;br&gt;&lt;br&gt;&lt;br&gt;&lt;b style='font-size:16px;color:#1F2937'&gt;A new version&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b style='color:#EC4899'&gt;A&lt;/b&gt;&amp;nbsp;&amp;nbsp;Argo CD pulls the k8s/ folder from GitHub.&lt;br&gt;&lt;br&gt;&lt;b style='color:#EC4899'&gt;B&lt;/b&gt;&amp;nbsp;&amp;nbsp;It applies the files to the next-bff namespace.&lt;br&gt;&lt;br&gt;&lt;b style='color:#EC4899'&gt;C&lt;/b&gt;&amp;nbsp;&amp;nbsp;The Deployment pulls the new image from ECR and replaces pods one at a time.&lt;br&gt;&lt;br&gt;&lt;b style='color:#EC4899'&gt;D&lt;/b&gt;&amp;nbsp;&amp;nbsp;The health-check Job calls the Service to confirm the release." style="fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;text;html=1;whiteSpace=wrap;fontSize=15;fontColor=#4B5563;align=left;verticalAlign=top;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1640" y="290" width="340" height="620" />
        </mxCell>
        <mxCell id="lg_title" value="&lt;b&gt;Lines&lt;/b&gt;" style="fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;text;html=1;whiteSpace=wrap;fontSize=15;fontColor=#1F2937;align=left;verticalAlign=top;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1640" y="926" width="200" height="24" />
        </mxCell>
        <mxCell id="lg0" value="" style="fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=14;fontStyle=1;labelBackgroundColor=#FFFFFF;fontColor=#4B5563;endSize=9;strokeColor=#3B82F6;strokeWidth=3;" edge="1" parent="1">
          <mxGeometry as="geometry" relative="1">
            <mxPoint as="sourcePoint" x="1640" y="960" />
            <mxPoint as="targetPoint" x="1710" y="960" />
