# uat: production-shaped (three AZs, same node sizes) so releases are tested on
# the same topology, with shorter log retention. Own AWS account and VPC range.
#
# CI: store the filled-in file as the repository secret UAT_TFVARS.
# Locally: copy to terraform.tfvars (git-ignored) and pass it with -var-file.
# `environment` is not set here: CI passes it, locally use -var environment=uat.

region   = "us-east-1"
azs      = ["us-east-1a", "us-east-1b", "us-east-1c"]
vpc_cidr = "10.15.0.0/16"

eks_admin_role_arns = [
  "arn:aws:iam::222222222222:role/aws-reserved/sso.amazonaws.com/AWSReservedSSO_AdministratorAccess_xxxxxxxx",
]

github_repository = "your-org/devops-challenge"

# From this account's infra/bootstrap outputs.
state_bucket_name = "next-bff-tfstate-222222222222-us-east-1"
state_kms_key_arn = "arn:aws:kms:us-east-1:222222222222:key/00000000-0000-0000-0000-000000000000"

# The parent zone lives in the prod account: delegate uat.example.com to the
# name servers in the hosted_zone_name_servers output.
hosted_zone_name   = "uat.example.com"
create_hosted_zone = true
domain_name        = "app.uat.example.com"

log_retention_days = 90

alert_emails = ["oncall@example.com"]
