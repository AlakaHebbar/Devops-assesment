# dev: the same code at a smaller size. Two AZs (the module minimum, one NAT
# gateway fewer), fewer nodes and short log retention. Own AWS account and
# VPC range.
#
# CI: store the filled-in file as the repository secret DEV_TFVARS.
# Locally: copy to terraform.tfvars (git-ignored) and pass it with -var-file.
# `environment` is not set here: CI passes it, locally use -var environment=dev.

region   = "us-east-1"
azs      = ["us-east-1a", "us-east-1b"]
vpc_cidr = "10.10.0.0/16"

eks_admin_role_arns = [
  "arn:aws:iam::111111111111:role/aws-reserved/sso.amazonaws.com/AWSReservedSSO_AdministratorAccess_xxxxxxxx",
]

node_min_size     = 2
node_desired_size = 2
node_max_size     = 4

github_repository = "your-org/devops-challenge"

# From this account's infra/bootstrap outputs.
state_bucket_name = "next-bff-tfstate-111111111111-us-east-1"
state_kms_key_arn = "arn:aws:kms:us-east-1:111111111111:key/00000000-0000-0000-0000-000000000000"

# The parent zone lives in the prod account: delegate dev.example.com to the
# name servers in the hosted_zone_name_servers output.
hosted_zone_name   = "dev.example.com"
create_hosted_zone = true
domain_name        = "app.dev.example.com"

log_retention_days = 30

alert_emails = ["dev-team@example.com"]
