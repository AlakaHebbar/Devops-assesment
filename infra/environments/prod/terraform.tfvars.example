# prod: the shape described in ARCHITECTURE.md. Variables not set here use the
# defaults in infra/core/variables.tf.
#
# CI: store the filled-in file as the repository secret PROD_TFVARS.
# Locally: copy to terraform.tfvars (git-ignored) and pass it with -var-file.
# `environment` is not set here: CI passes it, locally use -var environment=prod.

region = "us-east-1"
azs    = ["us-east-1a", "us-east-1b", "us-east-1c"]

eks_admin_role_arns = [
  "arn:aws:iam::123456789012:role/aws-reserved/sso.amazonaws.com/AWSReservedSSO_AdministratorAccess_xxxxxxxx",
]

github_repository = "your-org/devops-challenge"

# From this account's infra/bootstrap outputs.
state_bucket_name = "next-bff-tfstate-123456789012-us-east-1"
state_kms_key_arn = "arn:aws:kms:us-east-1:123456789012:key/00000000-0000-0000-0000-000000000000"

hosted_zone_name = "example.com"
domain_name      = "app.example.com"

alert_emails = ["oncall@example.com"]
